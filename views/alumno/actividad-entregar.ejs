<% const titulo='Entregar: '+act.titulo %><%- include('../partials/header') %>

<div class="content">
<div class="page-header"><div><h1>📝 <%= act.titulo %></h1><p><%= act.aula_nombre %></p></div></div>
<%
  const ahora = new Date();
  const limite = act.fecha_entrega ? new Date(act.fecha_entrega) : null;
  const vencidaSinEntrega = limite && ahora > limite && !entrega;
  const entregaTarde = entrega && limite && new Date(entrega.fecha_entrega) > limite;
%>
<% if(act.descripcion){ %><div class="alert alert-info"><strong>Consigna:</strong> <%= act.descripcion %></div><% } %>
<% if(limite){ %><div class="alert <%= vencidaSinEntrega ? 'alert-error' : 'alert-warning' %>">⏰ Fecha límite: <strong><%= limite.toLocaleString('es-AR') %></strong><% if(vencidaSinEntrega){ %> · <strong>¡Vencida!</strong> Podés entregar igual, pero quedará como fuera de término.<% } %></div><% } %>
<div class="card" style="max-width:600px">
<% if(entrega){ %>
  <div class="alert <%= entregaTarde ? 'alert-warning' : 'alert-success' %>"><%= entregaTarde ? '⚠️ Entregaste fuera de término' : '✅ Entrega realizada' %> · <%= new Date(entrega.fecha_entrega).toLocaleString('es-AR') %></div>
  <% if(entrega.nota!==null && entrega.nota!==undefined){ %>
    <div style="background:#F0FDF4;border:1px solid #BBF7D0;border-radius:10px;padding:1rem 1.25rem;margin-bottom:1rem">
      <div style="font-size:13px;color:#166534;font-weight:600">Tu calificación</div>
      <div style="font-size:32px;font-weight:800;color:#15803D;line-height:1.1"><%= entrega.nota %> <span style="font-size:15px;color:#16A34A">/ <%= act.puntaje_max %></span></div>
      <% if(entrega.feedback){ %>
        <div style="margin-top:10px;padding-top:10px;border-top:1px solid #BBF7D0">
          <div style="font-size:12px;color:#166534;font-weight:600;margin-bottom:4px">💬 Devolución del docente</div>
          <div style="font-size:14px;color:#14532D;line-height:1.6"><%= entrega.feedback %></div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="alert alert-info" style="margin-bottom:1rem">Tu entrega está pendiente de corrección.</div>
  <% } %>
<% } %>
<form method="POST" action="/alumno/actividades/<%= act.id %>/entregar" enctype="multipart/form-data">
  <div class="form-group"><label class="form-label">📎 Archivo (PDF, Word, imagen... máx 50 MB)</label><input type="file" name="archivo"></div>
  <div class="form-group"><label class="form-label">Comentario / Respuesta</label><textarea name="comentario" rows="6" placeholder="Escribí tu respuesta o comentarios sobre tu entrega..."><%= entrega?.comentario||'' %></textarea></div>
  <div class="modal-actions" style="justify-content:flex-start">
    <a href="javascript:history.back()" class="btn btn-secondary">Cancelar</a>
    <button type="submit" class="btn btn-primary">📤 <%= entrega ? 'Actualizar entrega' : 'Enviar entrega' %></button>
  </div>
</form>
</div></div><%- include('../partials/footer') %>
