<% const titulo='Evaluación: '+ev.titulo %><%- include('../partials/header') %>

<div class="content">
<div class="page-header"><div><h1>🎯 <%= ev.titulo %></h1><p><%= ev.aula_nombre %><% if(ev.tiempo_limite){ %> · Tiempo: <%= ev.tiempo_limite %> minutos<% } %></p></div></div>
<% if(ev.descripcion){ %><div class="alert alert-info"><%= ev.descripcion %></div><% } %>
<form method="POST" action="/alumno/evaluaciones/<%= ev.id %>/entregar" onsubmit="return confirm('¿Confirmar entrega? No podrás modificar tus respuestas.')">
<% preguntas.forEach((p,i)=>{ %>
  <div class="pregunta" style="margin-bottom:1rem">
    <div style="font-weight:600;font-size:14px;margin-bottom:10px"><%= i+1 %>. <%= p.texto %> <span style="font-size:12px;color:#9ca3af">(<%=p.puntaje%> pt)</span></div>
    <% if(p.tipo==='mc' && p.opciones){ %>
      <% p.opciones.forEach(op=>{ %>
        <label class="opcion"><input type="radio" name="preg_<%= p.id %>" value="<%= op %>" required> <%= op %></label>
      <% }) %>
    <% } else if(p.tipo==='vf'){ %>
      <label class="opcion"><input type="radio" name="preg_<%= p.id %>" value="verdadero"> Verdadero</label>
      <label class="opcion"><input type="radio" name="preg_<%= p.id %>" value="falso"> Falso</label>
    <% } else { %>
      <textarea name="preg_<%= p.id %>" rows="4" placeholder="Escribí tu respuesta..." style="margin-top:6px"></textarea>
    <% } %>
  </div>
<% }) %>
<div style="margin-top:2rem">
  <button type="submit" class="btn btn-primary" style="padding:12px 32px;font-size:15px">✅ Entregar evaluación</button>
</div>
</form>
</div><%- include('../partials/footer') %>
