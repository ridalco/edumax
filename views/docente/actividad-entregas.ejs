<% const titulo='Entregas - '+act.titulo %><%- include('../partials/header') %>

<div class="content">
<div class="page-header"><div><h1><%= act.titulo %></h1><p>Puntaje máximo: <%= act.puntaje_max %> · Fecha límite: <%= act.fecha_entrega ? new Date(act.fecha_entrega).toLocaleString('es-AR') : 'Sin límite' %></p></div></div>
<% if(act.descripcion){ %><div class="alert alert-info"><%= act.descripcion %></div><% } %>
<% if(!entregas.length){ %>
  <div class="card"><div class="empty-state"><h3>Sin entregas todavía</h3><p>Los alumnos aún no enviaron nada</p></div></div>
<% } else { %>
<% entregas.forEach(e=>{ %>
<div class="card" style="margin-bottom:1rem">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem">
    <div>
      <div style="font-weight:600;font-size:15px"><%= e.apellido %>, <%= e.nombre %></div>
      <div style="font-size:12px;color:#6b7280">Entregado: <%= new Date(e.fecha_entrega).toLocaleString('es-AR') %><% if(act.fecha_entrega && new Date(e.fecha_entrega) > new Date(act.fecha_entrega)){ %> <span class="badge badge-red">⚠️ Tarde</span><% } %></div>
      <% if(e.comentario){ %><p style="font-size:14px;margin-top:8px;color:#374151"><%= e.comentario %></p><% } %>
      <% if(e.archivo){ %><a href="/uploads/<%= e.archivo %>" download="<%= e.nombre_original %>" class="btn btn-sm btn-secondary" style="margin-top:8px">📎 Descargar: <%= e.nombre_original %></a><% } %>
    </div>
    <div style="min-width:220px">
      <% if(e.nota!==null && e.nota!==undefined){ %>
        <div class="alert alert-success">Calificado: <strong><%= e.nota %></strong> pts</div>
        <% if(e.feedback){ %><p style="font-size:13px;color:#374151"><%= e.feedback %></p><% } %>
      <% } %>
      <form method="POST" action="/docente/entregas/<%= e.id %>/calificar">
        <input type="hidden" name="redirect_to" value="/docente/actividades/<%= act.id %>">
        <div class="form-group"><label class="form-label">Nota (0-<%= act.puntaje_max %>)</label><input type="number" name="nota" min="0" max="<%= act.puntaje_max %>" step="0.1" value="<%= e.nota||'' %>" required></div>
        <div class="form-group"><label class="form-label">Feedback (opcional)</label><textarea name="feedback" rows="2"><%= e.feedback||'' %></textarea></div>
        <button type="submit" class="btn btn-primary btn-full">Guardar calificación</button>
      </form>
    </div>
  </div>
</div>
<% }) %>
<% } %>
</div><%- include('../partials/footer') %>
